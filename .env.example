DASHSCOPE_API_KEY=your_api_key_here
DASHSCOPE_BASE_URL=your_openai_compatible_base_url_here
DASHSCOPE_MODEL=your_model_id_here
# Default sends no provider-specific extensions. For Qwen providers requiring it:
# LITERATURE_BOT_EXTRA_BODY={"enable_thinking":false}
LITERATURE_BOT_EXTRA_BODY={}

# Paper-level ranking: SPECTER2 reranks arXiv candidates; PDF evidence remains BM25.
LITERATURE_BOT_PAPER_RETRIEVER=specter2
LITERATURE_BOT_SPECTER2_CANDIDATE_POOL=10

# Optional shadow diagnostics; install .[verification] and download weights first.
# off: no extra API calls. shadow: up to 8 claims, answer is never rewritten.
LITERATURE_BOT_VERIFICATION=off

# structured: each factual claim declares request-local evidence IDs.
# off: original free-text format. Binding does not certify factual correctness.
LITERATURE_BOT_BINDING=structured
# json_object requires provider support; prompt_only keeps strict local validation
# but has a higher risk of formatting failures.
LITERATURE_BOT_BINDING_FORMAT=json_object

# Independent local numeric audit; no extra model calls or answer rewriting.
# Supports explicit arithmetic and a narrow set of table/ratio/metric patterns.
LITERATURE_BOT_NUMERIC_VERIFICATION=shadow

# P2 records + unified diagnostic/conflict view; shadow-only, no answer rewriting.
LITERATURE_BOT_DIAGNOSTICS=shadow
